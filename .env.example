# Copy to .env.local and fill in.
#
# Next.js only exposes variables prefixed with NEXT_PUBLIC_ to the browser —
# never put the service-role key behind that prefix.

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-or-publishable-key>

# Canonical origin of the deployed site. Every Open Graph share card, the
# <link rel="canonical"> tags and sitemap.xml are built from this, so in
# production it must be the real public https:// URL (no trailing slash).
# Leave it at localhost and shared links advertise a dev machine.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only. Required by the user-management module for Supabase Auth
# Admin API calls (creating an account from /admin/users, deleting one) and by
# the "Add user" button. Without it those actions are disabled, not broken.
# Find it under Project Settings -> API. Never expose it with a NEXT_PUBLIC_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: overrides the bKash "Send Money" wallet shown at checkout.
# NEXT_PUBLIC_BKASH_NUMBER=01789138295

# Optional: automated order-confirmation e-mails (Resend).
# Leave both unset and the shop still takes orders — the checkout simply skips
# the e-mail. Server-side only: never prefix these with NEXT_PUBLIC_.
# RESEND_API_KEY=re_…
# ORDER_FROM_EMAIL=orders@your-domain.com   # a domain verified in Resend
